<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
>
    <changeSet id="002-1" author="Juan Valero">
        <createTable tableName="article_tags">
            <column name="article_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tag_id" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="002-2" author="Juan Valero">
        <createTable tableName="articles">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_articles"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="sub_title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="is_author_visible" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="002-3" author="Juan Valero">
        <createTable tableName="categories">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_categories"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="002-4" author="Juan Valero">
        <createTable tableName="tags">
            <column autoIncrement="true" name="id" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tags"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="002-5" author="Juan Valero">
        <addUniqueConstraint columnNames="name" constraintName="uc_categories_name" tableName="categories"/>
    </changeSet>
    <changeSet id="002-6" author="Juan Valero">
        <addUniqueConstraint columnNames="name" constraintName="uc_tags_name" tableName="tags"/>
    </changeSet>
    <changeSet id="002-7" author="Juan Valero">
        <addForeignKeyConstraint baseColumnNames="author_id" baseTableName="articles"
                                 constraintName="FK_ARTICLES_ON_AUTHOR" referencedColumnNames="id"
                                 referencedTableName="users"/>
    </changeSet>
    <changeSet id="002-8" author="Juan Valero">
        <addForeignKeyConstraint baseColumnNames="category_id" baseTableName="articles"
                                 constraintName="FK_ARTICLES_ON_CATEGORY" referencedColumnNames="id"
                                 referencedTableName="categories"/>
    </changeSet>
    <changeSet id="002-9" author="Juan Valero">
        <addForeignKeyConstraint baseColumnNames="article_id" baseTableName="article_tags"
                                 constraintName="fk_arttag_on_article" referencedColumnNames="id"
                                 referencedTableName="articles"/>
    </changeSet>
    <changeSet id="002-10" author="Juan Valero">
        <addForeignKeyConstraint baseColumnNames="tag_id" baseTableName="article_tags" constraintName="fk_arttag_on_tag"
                                 referencedColumnNames="id" referencedTableName="tags"/>
    </changeSet>
</databaseChangeLog>
